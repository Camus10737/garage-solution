# Mêmes valeurs que backend/.env — dupliquées ici car la Cloud Function tourne indépendamment du
# serveur FastAPI et ne partage pas son fichier .env.

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15140000000

# SMTP (envoi courriel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton-adresse@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=ton-adresse@gmail.com
